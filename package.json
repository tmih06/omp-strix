{
  "name": "omp-strix",
  "version": "0.1.3",
  "description": "Strix adversarial security-testing mode for omp — /strix toggles a full multi-agent pentest workflow",
  "type": "module",
  "license": "Apache-2.0",
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "keywords": [
    "omp",
    "plugin",
    "strix",
    "security",
    "pentest"
  ],
  "files": [
    "src",
    "agents",
    "strix",
    "themes",
    "sandbox",
    "plugin.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
